# Copy this file to .env and fill in the values. Never commit .env.

# PayPal sandbox REST app (Business sandbox account) - developer.paypal.com
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
