# Copy this file to .env and fill in the values. Never commit .env.

# PayPal sandbox REST app (Business sandbox account) - developer.paypal.com
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional, not secret: the sandbox Business account that sends the invoices
# PAYPAL_MERCHANT_EMAIL=
# Optional guards for sending and refreshing invoices (per visitor per minute, and per day)
# PAYPAL_LIMIT_PER_MINUTE=12
# PAYPAL_LIMIT_PER_DAY=400
# Filled in later (Phase 5), after the webhook is registered
PAYPAL_WEBHOOK_ID=

# Google AI Studio - aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional, not secret. Models are tried in this order; defaults are shown.
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash
# Optional guards for the public demo (receipt reads per visitor per minute, and per day)
# READ_LIMIT_PER_MINUTE=6
# READ_LIMIT_PER_DAY=300

# Google Cloud (not secret)
GCP_PROJECT=core-invention-cvz43
GCP_REGION=europe-west4
# Where receipts are kept. "memory" (default): lost when the server stops, starts with three
# fictional samples. "firestore": saved in the Firestore database below. Locally, Firestore
# needs one-time Google login: gcloud auth application-default login
# DATA_STORE=firestore
# FIRESTORE_DATABASE=caresplit
