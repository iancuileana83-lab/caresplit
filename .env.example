# Copy this file to .env and fill in the values. Never commit .env.

# PayPal sandbox REST app (Business sandbox account) - developer.paypal.com
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Filled in later (Phase 5), after the webhook is registered
PAYPAL_WEBHOOK_ID=

# Google AI Studio - aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional, not secret. Models are tried in this order; defaults are shown.
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash
# Optional guards for the public demo (receipt reads per visitor per minute, and per day)
# READ_LIMIT_PER_MINUTE=6
# READ_LIMIT_PER_DAY=300

# Google Cloud (not secret)
GCP_PROJECT=core-invention-cvz43
GCP_REGION=europe-west4
